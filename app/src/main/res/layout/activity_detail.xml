<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F6F8"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CHI TIẾT SINH VIÊN"
            android:textColor="#243447"
            android:textSize="24sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="24dp" />

        <TextView
            android:id="@+id/tvChiTietHoTen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Họ và tên:"
            android:textColor="#243447"
            android:textSize="16sp"
            android:padding="12dp" />

        <TextView
            android:id="@+id/tvChiTietEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Email:"
            android:textColor="#243447"
            android:textSize="16sp"
            android:padding="12dp" />

        <TextView
            android:id="@+id/tvChiTietSoDienThoai"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Số điện thoại:"
            android:textColor="#243447"
            android:textSize="16sp"
            android:padding="12dp" />

        <TextView
            android:id="@+id/tvChiTietMssv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Mã số sinh viên:"
            android:textColor="#243447"
            android:textSize="16sp"
            android:padding="12dp" />

        <TextView
            android:id="@+id/tvChiTietLop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Lớp:"
            android:textColor="#243447"
            android:textSize="16sp"
            android:padding="12dp" />

        <Button
            android:id="@+id/btnQuayLai"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Quay lại đăng ký"
            android:textAllCaps="false"
            android:layout_marginTop="24dp" />

    </LinearLayout>
</ScrollView>
